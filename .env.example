BLASTEX_SITE_ADDRESS=http://localhost
BLASTEX_CORS_ORIGINS=http://localhost
BLASTEX_COOKIE_SECURE=false
BLASTEX_API_KEY=replace-with-a-long-random-api-key
BLASTEX_SESSION_SECRET=replace-with-a-different-long-random-session-secret
# Обязательная переменная: без неё API не стартует.
BLASTEX_DATABASE_URL=postgresql+psycopg://blastex:replace-password@postgres:5432/project1
# Пароль сервиса postgres из docker-compose.yml (совпадает с паролем в URL выше)
POSTGRES_PASSWORD=replace-password
BLASTEX_USERS_JSON='[{"email":"admin@example.ru","password_hash":"replace-with-generated-hash","role":"admin","display_name":"Администратор","organization_id":"default","organization_name":"Моя компания","active":true}]'
# ML-слой (BDX-011…BDX-023) по умолчанию выключен: маршруты отдают 501
BLASTEX_INTELLIGENCE_ENABLED=false
