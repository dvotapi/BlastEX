# Скопируйте в .streamlit/secrets.toml (файл не коммитится):
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# Хеш создаётся командой:
# python3 scripts/hash_password.py
# Альтернатива: JSON-массив в переменной окружения BLASTEX_USERS_JSON.

[blastex]

[[blastex.users]]
email = "admin@example.ru"
password_hash = "pbkdf2_sha256$600000$replace-with-generated-value"
role = "admin" # admin | reference_editor | user
display_name = "Администратор"
organization_id = "default"
organization_name = "Моя компания"
active = true
