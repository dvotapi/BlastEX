{$BLASTEX_SITE_ADDRESS:http://localhost} {
    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8000
    }

    # Открытые ключи BlastEX для MagEX (TASK-018, PR 7).
    handle /.well-known/jwks.json {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
